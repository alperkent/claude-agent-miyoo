{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "miyoo-relay",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE",
				"class_name": "DeviceRoom"
			},
			{
				"name": "PAIRING",
				"class_name": "PairingIndex"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceRoom",
				"PairingIndex"
			]
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "REPLACE_WITH_YOUR_KV_ID"
		}
	],
	"vars": {
		// only Claude's connector may sign in (comma-separated host names)
		"ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com",
		// how many Miyoos may register on this relay
		"MAX_DEVICES": "5"
	},
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}